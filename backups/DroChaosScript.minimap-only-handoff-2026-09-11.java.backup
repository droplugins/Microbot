package net.runelite.client.plugins.microbot.drochaos;

import lombok.Getter;
import net.runelite.api.Client;
import net.runelite.api.CollisionDataFlag;
import net.runelite.api.Point;
import net.runelite.api.InventoryID;
import net.runelite.api.Item;
import net.runelite.api.ItemContainer;
import net.runelite.api.ItemID;
import net.runelite.api.Player;
import net.runelite.api.Skill;
import net.runelite.api.WorldType;
import net.runelite.api.coords.WorldArea;
import net.runelite.api.coords.LocalPoint;
import net.runelite.api.coords.WorldPoint;
import net.runelite.client.plugins.microbot.Microbot;
import net.runelite.client.plugins.microbot.Script;
import net.runelite.client.plugins.microbot.api.tileobject.models.Rs2TileObjectModel;
import net.runelite.client.plugins.microbot.shortestpath.ShortestPathPlugin;
import net.runelite.client.plugins.microbot.util.antiban.Rs2Antiban;
import net.runelite.client.plugins.microbot.util.bank.Rs2Bank;
import net.runelite.client.plugins.microbot.util.bank.enums.BankLocation;
import net.runelite.client.plugins.microbot.util.combat.Rs2Combat;
import net.runelite.client.plugins.microbot.util.dialogues.Rs2Dialogue;
import net.runelite.client.plugins.microbot.util.equipment.Rs2Equipment;
import net.runelite.client.plugins.microbot.util.gameobject.Rs2GameObject;
import net.runelite.client.plugins.microbot.util.inventory.Rs2Inventory;
import net.runelite.client.plugins.microbot.util.inventory.Rs2ItemModel;
import net.runelite.client.plugins.microbot.util.player.Rs2Player;
import net.runelite.client.plugins.microbot.util.player.Rs2Pvp;
import net.runelite.client.plugins.microbot.util.tabs.Rs2Tab;
import net.runelite.client.plugins.microbot.util.walker.Rs2Walker;
import net.runelite.client.plugins.microbot.util.walker.Rs2MiniMap;
import net.runelite.client.plugins.microbot.util.widget.Rs2Widget;

import java.util.List;
import java.util.concurrent.TimeUnit;
import java.util.concurrent.ThreadLocalRandom;
import java.util.concurrent.atomic.AtomicBoolean;

public class DroChaosScript extends Script
{
    private static final int CHAOS_ALTAR_ID = 411;
    private static final int MINIMUM_COMBAT_LEVEL = 3;
    private static final int MAXIMUM_COMBAT_LEVEL = 126;
    private static final int[] CHARGED_BURNING_AMULETS = {
            ItemID.BURNING_AMULET5,
            ItemID.BURNING_AMULET4,
            ItemID.BURNING_AMULET3,
            ItemID.BURNING_AMULET2,
            ItemID.BURNING_AMULET1
    };

    private static final WorldArea CHAOS_TEMPLE = new WorldArea(2947, 3818, 11, 6, 0);
    private static final WorldArea LUMBRIDGE_GROUND = new WorldArea(3200, 3200, 30, 30, 0);
    private static final WorldArea LUMBRIDGE_MIDDLE = new WorldArea(3200, 3200, 30, 30, 1);
    private static final WorldArea EDGEVILLE_RESPAWN = new WorldArea(3060, 3450, 66, 70, 0);
    private static final long MIN_MISCLICK_INTERVAL_MS = TimeUnit.MINUTES.toMillis(5);
    private static final long MAX_MISCLICK_INTERVAL_MS = TimeUnit.MINUTES.toMillis(15);
    private static final int MIN_ACTION_DELAY_MS = 50;
    private static final int MAX_ACTION_DELAY_MS = 250;

    private static final WorldPoint[] PATH_TO_ALTAR = {
            new WorldPoint(3025, 3836, 0),
            new WorldPoint(3015, 3835, 0),
            new WorldPoint(3002, 3832, 0),
            new WorldPoint(2988, 3828, 0),
            new WorldPoint(2975, 3825, 0),
            new WorldPoint(2960, 3822, 0),
            new WorldPoint(2949, 3820, 0)
    };

    private DroChaosConfig config;
    private boolean autoRetaliateConfigured;
    private boolean stateInitialized;
    private boolean bankRequired;
    private boolean bankInventoryCleared;
    private boolean boneWithdrawalIssued;
    private volatile boolean intentionallySuiciding;
    private long nextMisclickAt;
    private long nextBankActionAt;
    private long nextMovementAt;
    private long nextDoorActionAt;
    private WorldPoint lastMovementTarget;
    private WorldPoint lastMinimapTile;
    private WorldPoint lastMovementPosition;
    private long lastMovementProgressAt;
    private final AtomicBoolean threatLogoutActive = new AtomicBoolean(false);

    @Getter
    private volatile String status = "Idle";

    public boolean run(DroChaosConfig config)
    {
        this.config = config;
        Microbot.enableAutoRunOn = false;
        ShortestPathPlugin.exit();
        autoRetaliateConfigured = false;
        stateInitialized = false;
        bankRequired = false;
        bankInventoryCleared = false;
        boneWithdrawalIssued = false;
        intentionallySuiciding = false;
        scheduleNextMisclick();
        nextBankActionAt = 0L;
        nextMovementAt = 0L;
        nextDoorActionAt = 0L;
        lastMovementTarget = null;
        lastMinimapTile = null;
        lastMovementPosition = null;
        lastMovementProgressAt = 0L;

        scheduledFuture = scheduledExecutorService.scheduleWithFixedDelay(() -> {
            try
            {
                if (!Microbot.isLoggedIn())
                {
                    threatLogoutActive.set(false);
                    return;
                }
                if (Rs2Pvp.isInWilderness() && !intentionallySuiciding && hasNearbyThreat())
                {
                    requestThreatLogout();
                }
            }
            catch (Exception exception)
            {
                Microbot.log("DroChaos threat watcher failed: " + exception.getMessage());
            }
        }, 0, 100, TimeUnit.MILLISECONDS);

        mainScheduledFuture = scheduledExecutorService.scheduleWithFixedDelay(() -> {
            try
            {
                if (!Microbot.isLoggedIn() || !super.run())
                {
                    return;
                }

                if (threatLogoutActive.get())
                {
                    return;
                }

                if (!autoRetaliateConfigured)
                {
                    Rs2Combat.setAutoRetaliate(false);
                    autoRetaliateConfigured = true;
                }

                if (!intentionallySuiciding && logoutForThreat())
                {
                    return;
                }

                runLoopStep();
            }
            catch (Exception exception)
            {
                Microbot.log("DroChaos loop failed: " + exception.getMessage());
                status = "Recovering";
            }
        }, 0, 100, TimeUnit.MILLISECONDS);
        return true;
    }

    private void runLoopStep()
    {
        WorldPoint location = getSafeWorldLocation();
        if (location == null)
        {
            status = "Waiting for player";
            return;
        }

        boolean inWilderness = Rs2Pvp.isInWilderness() || Rs2Pvp.getWildernessLevelFrom(location) > 0;
        boolean hasBones = getLiveDragonBoneCount() > 0;
        intentionallySuiciding = inWilderness && !hasBones;

        if (!stateInitialized)
        {
            bankRequired = !inWilderness && (!hasBones || !hasBurningAmulet());
            stateInitialized = true;
        }

        if (handleScheduledMisclick(inWilderness))
        {
            return;
        }

        if (inWilderness)
        {
            if (hasBones)
            {
                walkToAltarAndSacrifice();
            }
            else
            {
                bankRequired = true;
                suicideWithWine();
            }
        }
        else
        {
            if (!hasBones || !hasBurningAmulet())
            {
                bankRequired = true;
            }

            if (!bankRequired && hasBones && hasBurningAmulet())
            {
                teleportToWilderness();
            }
            else if (LUMBRIDGE_GROUND.contains(location) || LUMBRIDGE_MIDDLE.contains(location))
            {
                walkUpstairsLumbridge();
            }
            else if (Rs2Bank.isNearBank(20))
            {
                restockFromBank();
            }
            else if (EDGEVILLE_RESPAWN.contains(location))
            {
                status = "Walking to Edgeville bank";
                walkMinimapThrottled(BankLocation.EDGEVILLE.getWorldPoint(), location);
            }
            else
            {
                executeHomeTeleport();
            }
        }
    }

    private void walkToAltarAndSacrifice()
    {
        WorldPoint location = getSafeWorldLocation();
        if (location == null)
        {
            return;
        }
        WorldPoint altar = PATH_TO_ALTAR[PATH_TO_ALTAR.length - 1];

        if (CHAOS_TEMPLE.contains(location) && location.distanceTo(altar) <= 1)
        {
            offerBonesFast();
            return;
        }

        WorldPoint entrance = PATH_TO_ALTAR[PATH_TO_ALTAR.length - 2];
        if (location.distanceTo(entrance) <= 3 || CHAOS_TEMPLE.contains(location))
        {
            status = "Entering temple";
            if (!handleTempleDoor())
            {
                walkMinimapThrottled(altar, location);
            }
            return;
        }

        status = "Walking to altar";
        WorldPoint target = getNextWaypoint(location);
        if (altar.equals(target))
        {
            target = entrance;
        }

        if (target != null && location.distanceTo(target) > 1)
        {
            walkMinimapThrottled(target, location);
        }
    }

    private boolean handleTempleDoor()
    {
        Rs2TileObjectModel door = findClosedTempleDoor();
        if (door == null)
        {
            // Allow the server's door/collision update to settle before walking.
            return System.currentTimeMillis() < nextDoorActionAt;
        }
        status = "Opening temple door";
        if (System.currentTimeMillis() < nextDoorActionAt)
        {
            return true;
        }
        if (Rs2Inventory.isItemSelected())
        {
            pauseBeforeAction();
            Rs2Inventory.deselect();
            return true;
        }
        pauseBeforeAction();
        Microbot.getRs2TileObjectCache().query()
                .withId(door.getId())
                .where(object -> door.getWorldLocation().equals(object.getWorldLocation()))
                .interact("Open");
        nextDoorActionAt = System.currentTimeMillis() + 1800L;
        return true;
    }

    private Rs2TileObjectModel findClosedTempleDoor()
    {
        WorldPoint altar = PATH_TO_ALTAR[PATH_TO_ALTAR.length - 1];
        return Microbot.getClientThread().runOnClientThreadOptional(() ->
                Microbot.getRs2TileObjectCache().query()
                        .withName("Door")
                        .within(altar, 12)
                        .where(object -> {
                            var composition = object.getObjectComposition();
                            if (composition == null) return false;
                            if (composition.getImpostorIds() != null)
                            {
                                composition = composition.getImpostor();
                            }
                            if (composition == null || composition.getActions() == null) return false;
                            for (String action : composition.getActions())
                            {
                                if ("Open".equalsIgnoreCase(action)) return true;
                            }
                            return false;
                        })
                        .nearest()).orElse(null);
    }

    private void walkMinimapThrottled(WorldPoint target, WorldPoint location)
    {
        long now = System.currentTimeMillis();
        if (!location.equals(lastMovementPosition))
        {
            lastMovementPosition = location;
            lastMovementProgressAt = now;
        }
        if (now < nextMovementAt)
        {
            return;
        }
        if (target.equals(lastMovementTarget) && Rs2Player.isMoving()
                && lastMinimapTile != null && location.distanceTo(lastMinimapTile) > 3
                && now - lastMovementProgressAt < 1800L)
        {
            return;
        }
        pauseBeforeAction();
        if (clickRouteMinimap(target, location))
        {
            lastMovementTarget = target;
        }
        nextMovementAt = System.currentTimeMillis()
                + ThreadLocalRandom.current().nextLong(900L, 1201L);
    }

    private boolean clickRouteMinimap(WorldPoint target, WorldPoint location)
    {
        int distance = location.distanceTo(target);
        if (distance == 0 || location.getPlane() != target.getPlane()) return false;
        // Shorten an off-minimap leg without ever falling back to a floor click.
        for (int step = Math.min(distance, 16); step >= 1; step--)
        {
            WorldPoint base = new WorldPoint(
                    location.getX() + (int) Math.round((target.getX() - location.getX()) * (double) step / distance),
                    location.getY() + (int) Math.round((target.getY() - location.getY()) * (double) step / distance),
                    location.getPlane());
            boolean vary = base.getX() >= 2970 && target.getX() >= 2970;
            for (int attempt = 0; attempt < (vary ? 5 : 1); attempt++)
            {
                WorldPoint tile = vary && attempt < 4
                        ? new WorldPoint(base.getX() + ThreadLocalRandom.current().nextInt(-1, 2),
                                base.getY() + ThreadLocalRandom.current().nextInt(-1, 2), base.getPlane())
                        : base;
                if (tile.equals(location) || (vary && attempt < 4 && tile.equals(lastMinimapTile))) continue;
                Point point = Microbot.getClientThread().runOnClientThreadOptional(() -> {
                    var view = Microbot.getClient().getTopLevelWorldView();
                    if (view == null || view.getCollisionMaps() == null) return null;
                    LocalPoint local = LocalPoint.fromWorld(view, tile);
                    if (local == null || view.getCollisionMaps()[tile.getPlane()] == null) return null;
                    int[][] flags = view.getCollisionMaps()[tile.getPlane()].getFlags();
                    int x = local.getSceneX(), y = local.getSceneY();
                    if (x < 0 || x >= flags.length || y < 0 || y >= flags[x].length
                            || (flags[x][y] & CollisionDataFlag.BLOCK_MOVEMENT_FULL) != 0) return null;
                    Point projected = Rs2MiniMap.worldToMinimap(tile);
                    return projected != null && Rs2MiniMap.isPointInsideMinimap(projected) ? projected : null;
                }).orElse(null);
                if (point != null)
                {
                    Microbot.getMouse().click(point);
                    lastMinimapTile = tile;
                    return true;
                }
            }
        }
        return false;
    }

    private WorldPoint getNextWaypoint(WorldPoint playerLoc)
    {
        for (int i = PATH_TO_ALTAR.length - 1; i >= 0; i--)
        {
            if (playerLoc.distanceTo(PATH_TO_ALTAR[i]) <= 16)
            {
                if (playerLoc.distanceTo(PATH_TO_ALTAR[i]) <= 2 && i + 1 < PATH_TO_ALTAR.length)
                {
                    return PATH_TO_ALTAR[i + 1];
                }
                return PATH_TO_ALTAR[i];
            }
        }

        WorldPoint closest = PATH_TO_ALTAR[0];
        int minDist = playerLoc.distanceTo(closest);
        for (int i = 1; i < PATH_TO_ALTAR.length; i++)
        {
            int dist = playerLoc.distanceTo(PATH_TO_ALTAR[i]);
            if (dist < minDist)
            {
                minDist = dist;
                closest = PATH_TO_ALTAR[i];
            }
        }
        return closest;
    }

    private void restockFromBank()
    {
        status = "Restocking";

        if (System.currentTimeMillis() < nextBankActionAt)
        {
            return;
        }

        if (!Rs2Bank.isOpen())
        {
            pauseBeforeAction();
            Rs2Bank.openBank();
            scheduleNextBankAction();
            return;
        }

        if (!bankInventoryCleared)
        {
            if (Rs2Inventory.count() > 0 || getLiveDragonBoneCount() > 0)
            {
                pauseBeforeAction();
                Rs2Bank.depositAll();
                scheduleNextBankAction();
                return;
            }
            bankInventoryCleared = true;
            return;
        }

        if (!hasBurningAmulet())
        {
            int amuletId = firstChargedBurningAmuletInBank();
            if (amuletId == -1)
            {
                stopForMissingSupply("No charged Burning amulet in bank");
                return;
            }
            pauseBeforeAction();
            Rs2Bank.withdrawAndEquip(amuletId);
            scheduleNextBankAction();
            return;
        }

        if (getLiveDragonBoneCount() == 0)
        {
            if (!Rs2Bank.hasItem(ItemID.DRAGON_BONES))
            {
                stopForMissingSupply("No Dragon bones in bank");
                return;
            }
            pauseBeforeAction();
            if (Rs2Bank.withdrawAll(ItemID.DRAGON_BONES))
            {
                boneWithdrawalIssued = true;
            }
            scheduleNextBankAction();
            return;
        }

        if (bankRequired && !boneWithdrawalIssued)
        {
            return;
        }

        pauseBeforeAction();
        if (Rs2Bank.closeBank())
        {
            bankRequired = false;
            bankInventoryCleared = false;
            boneWithdrawalIssued = false;
            status = "Supplies ready";
        }
        scheduleNextBankAction();
    }

    private void walkUpstairsLumbridge()
    {
        WorldPoint location = getSafeWorldLocation();
        if (location == null || location.getPlane() >= 2)
        {
            return;
        }

        int plane = location.getPlane();
        // The middle-floor staircase has a different object ID and both
        // directions. Never select a same-named staircase on another floor.
        int staircaseId = plane == 0 ? 56230 : 16672;
        String climbAction = plane == 0 ? "Top-floor" : "Climb-up";
        Rs2TileObjectModel staircase = Microbot.getRs2TileObjectCache().query()
                .withId(staircaseId)
                .where(object -> object.getWorldLocation() != null
                        && object.getWorldLocation().getPlane() == plane
                        && object.getWorldLocation().distanceTo(location) <= 32)
                .nearest();

        status = "Walking upstairs to bank";
        pauseBeforeAction();
        if (staircase != null && Microbot.getRs2TileObjectCache().query()
                .withId(staircaseId)
                .where(object -> staircase.getWorldLocation().equals(object.getWorldLocation()))
                .interact(climbAction))
        {
            boolean climbed = sleepUntil(() -> {
                WorldPoint current = getSafeWorldLocation();
                return current != null && current.getPlane() == 2;
            }, 5000);
            if (!climbed)
            {
                status = "Stair climb not confirmed - retrying";
            }
        }
        else
        {
            WorldPoint south = new WorldPoint(3206, 3208, plane);
            WorldPoint north = new WorldPoint(3206, 3229, plane);
            WorldPoint stairsLoc = location.distanceTo(north) < location.distanceTo(south)
                    ? north : south;
            walkMinimapThrottled(stairsLoc, location);
        }
    }

    private void executeHomeTeleport()
    {
        status = "Lost - Using Home Teleport";
        if (Rs2Bank.isOpen())
        {
            pauseBeforeAction();
            Rs2Bank.closeBank();
            return;
        }

        pauseBeforeAction();
        Rs2Tab.switchToMagicTab();

        pauseBeforeAction();
        if (Rs2Widget.clickWidget("Lumbridge Home Teleport"))
        {
            sleepUntil(() -> LUMBRIDGE_GROUND.contains(getSafeWorldLocation()), 15000);
        }
    }

    private void teleportToWilderness()
    {
        if (bankRequired || getLiveDragonBoneCount() == 0)
        {
            bankRequired = true;
            status = "Bones required - banking";
            return;
        }

        status = "Teleporting to Lava Maze";
        pauseBeforeAction();
        if (Rs2Equipment.interact(CHARGED_BURNING_AMULETS, "Lava Maze")
                && sleepUntil(Rs2Dialogue::isInDialogue, 2000))
        {
            if (getLiveDragonBoneCount() == 0)
            {
                bankRequired = true;
                return;
            }
            pauseBeforeAction();
            Rs2Dialogue.clickOption("Okay, teleport to level");
            sleepUntil(() -> {
                WorldPoint location = getSafeWorldLocation();
                return location != null && Rs2Pvp.getWildernessLevelFrom(location) > 0;
            }, 5000);
        }
    }

    private void offerBonesFast()
    {
        if (logoutForThreat())
        {
            return;
        }

        status = "Offering bones (Fast)";
        List<Rs2ItemModel> bones = Rs2Inventory.getBones();
        if (bones == null || bones.isEmpty())
        {
            return;
        }

        for (Rs2ItemModel bone : bones)
        {
            if (bone == null || !Microbot.isLoggedIn() || Thread.currentThread().isInterrupted())
            {
                break;
            }
            WorldPoint location = getSafeWorldLocation();
            if (location == null || !CHAOS_TEMPLE.contains(location)
                    || location.distanceTo(PATH_TO_ALTAR[PATH_TO_ALTAR.length - 1]) > 1)
            {
                return;
            }
            if (logoutForThreat())
            {
                return;
            }
            if (getLiveDragonBoneCount() <= 1)
            {
                bankRequired = true;
                intentionallySuiciding = true;
            }
            if (Rs2Inventory.interact(bone, "Use"))
            {
                sleep(15, 35);
                Rs2GameObject.interact(CHAOS_ALTAR_ID, "Use");
                sleep(40, 70);
            }
        }
    }

    private void suicideWithWine()
    {
        status = "Suiciding on wine";
        intentionallySuiciding = true;

        WorldPoint location = getSafeWorldLocation();
        WorldPoint altar = PATH_TO_ALTAR[PATH_TO_ALTAR.length - 1];
        if (location == null) return;
        if (location.distanceTo(altar) > 1 && location.distanceTo(altar) <= 15
                && handleTempleDoor())
        {
            return;
        }

        if (Rs2Inventory.contains("Wine of zamorak"))
        {
            pauseBeforeAction();
            Rs2Inventory.drop("Wine of zamorak", true);
            return;
        }

        pauseBeforeAction();
        boolean tookWine = Microbot.getRs2TileItemCache().query()
                .withName("Wine of zamorak")
                .within(12)
                .interact("Take");

        if (tookWine)
        {
            return;
        }
        else
        {
            if (location.distanceTo(altar) > 3)
            {
                walkMinimapThrottled(altar, location);
            }
        }
    }

    private void pauseBeforeAction()
    {
        int delay = ThreadLocalRandom.current().nextInt(MIN_ACTION_DELAY_MS, MAX_ACTION_DELAY_MS + 1);
        if (ThreadLocalRandom.current().nextInt(100) < 8)
        {
            delay += ThreadLocalRandom.current().nextInt(100, 351);
        }
        sleep(delay);
    }

    private boolean handleScheduledMisclick(boolean inWilderness)
    {
        long now = System.currentTimeMillis();
        if (now < nextMisclickAt || inWilderness || Rs2Bank.isOpen()
                || Rs2Player.isMoving() || Rs2Player.isAnimating())
        {
            return false;
        }

        scheduleNextMisclick();
        status = "Brief hesitation";
        pauseBeforeAction();
        Rs2Antiban.moveMouseOffScreen();
        return true;
    }

    private void scheduleNextMisclick()
    {
        nextMisclickAt = System.currentTimeMillis()
                + ThreadLocalRandom.current().nextLong(MIN_MISCLICK_INTERVAL_MS, MAX_MISCLICK_INTERVAL_MS + 1);
    }

    private void scheduleNextBankAction()
    {
        nextBankActionAt = System.currentTimeMillis()
                + ThreadLocalRandom.current().nextLong(600L, 901L);
    }

    public String getBankName()
    {
        WorldPoint location = getSafeWorldLocation();
        if (location != null && location.getY() < 3300)
        {
            return "Lumbridge Bank";
        }
        return "Nearest Bank";
    }

    private boolean hasBurningAmulet()
    {
        return Rs2Inventory.contains(item -> item != null
                && item.getName().toLowerCase().contains("burning amulet"))
                || Rs2Equipment.isWearing("burning amulet", false);
    }

    private int firstChargedBurningAmuletInBank()
    {
        for (int amuletId : CHARGED_BURNING_AMULETS)
        {
            if (Rs2Bank.hasItem(amuletId))
            {
                return amuletId;
            }
        }
        return -1;
    }

    private int getLiveDragonBoneCount()
    {
        return Microbot.getClientThread().runOnClientThreadOptional(() -> {
            Client client = Microbot.getClient();
            ItemContainer inventory = client == null ? null : client.getItemContainer(InventoryID.INVENTORY);
            if (inventory == null || inventory.getItems() == null)
            {
                return 0;
            }

            int count = 0;
            for (Item item : inventory.getItems())
            {
                if (item != null && item.getId() == ItemID.DRAGON_BONES)
                {
                    count += item.getQuantity();
                }
            }
            return count;
        }).orElse(0);
    }

    private WorldPoint getSafeWorldLocation()
    {
        return Microbot.getClientThread().runOnClientThreadOptional(() -> {
            Client client = Microbot.getClient();
            Player localPlayer = client == null ? null : client.getLocalPlayer();
            return localPlayer == null ? null : localPlayer.getWorldLocation();
        }).orElse(null);
    }

    private boolean logoutForThreat()
    {
        if (!Rs2Pvp.isInWilderness() || !hasNearbyThreat())
        {
            return false;
        }

        status = "Threat detected - logging out";
        requestThreatLogout();
        return true;
    }

    private void requestThreatLogout()
    {
        if (!threatLogoutActive.compareAndSet(false, true))
        {
            return;
        }

        try
        {
            status = "Threat detected - logging out";
            Microbot.log("DroChaos: threatening player detected; logging out");
            pauseBeforeAction();
            Rs2Player.logout();
            sleep(500, 800);
        }
        finally
        {
            if (Microbot.isLoggedIn())
            {
                threatLogoutActive.set(false);
            }
        }
    }

    private boolean hasNearbyThreat()
    {
        return Microbot.getClientThread().runOnClientThreadOptional(() -> {
            Client client = Microbot.getClient();
            Player localPlayer = client == null ? null : client.getLocalPlayer();
            if (localPlayer == null)
            {
                return false;
            }

            WorldPoint localLocation = localPlayer.getWorldLocation();
            int wildernessLevel = Rs2Pvp.getWildernessLevelFrom(localLocation);
            if (wildernessLevel <= 0)
            {
                return false;
            }

            boolean deadmanWorld = WorldType.isDeadmanWorld(client.getWorldType());
            int attackRange = wildernessLevel + (WorldType.isPvpWorld(client.getWorldType()) ? 15 : 0);
            int localCombat = localPlayer.getCombatLevel();
            int minimumThreatLevel = deadmanWorld
                    ? MINIMUM_COMBAT_LEVEL
                    : Math.max(MINIMUM_COMBAT_LEVEL, localCombat - attackRange);
            int maximumThreatLevel = Math.min(MAXIMUM_COMBAT_LEVEL,
                    deadmanWorld
                            ? MAXIMUM_COMBAT_LEVEL
                            : localCombat + attackRange + config.upperCombatBuffer());
            List<Player> players = client.getPlayers();

            for (Player player : players)
            {
                if (player == null || player == localPlayer || player.getWorldLocation() == null)
                {
                    continue;
                }
                if (player.getWorldLocation().distanceTo(localLocation) > config.threatRadius())
                {
                    continue;
                }

                int combatLevel = player.getCombatLevel();
                if (combatLevel >= minimumThreatLevel && combatLevel <= maximumThreatLevel)
                {
                    return true;
                }
            }
            return false;
        }).orElse(false);
    }

    private void stopForMissingSupply(String message)
    {
        status = message;
        Microbot.log("DroChaos: " + message + "; stopping script");
        shutdown();
    }

    @Override
    public void shutdown()
    {
        autoRetaliateConfigured = false;
        stateInitialized = false;
        bankRequired = false;
        bankInventoryCleared = false;
        boneWithdrawalIssued = false;
        intentionallySuiciding = false;
        nextMisclickAt = 0L;
        nextBankActionAt = 0L;
        threatLogoutActive.set(false);
        status = "Idle";
        super.shutdown();
    }
}
